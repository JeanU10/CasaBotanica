---
import BaseLayout from '../layouts/BaseLayout.astro';
import BotanicalParticles from '../components/BotanicalParticles.astro';
import ComfortQuiz from '../components/ComfortQuiz.astro';
import { ROOMS_CATALOG } from '../scripts/bookingStore';

const featuredRooms = ROOMS_CATALOG.slice(0, 3);

const comfortHighlights = [
  {
    title: 'Sábanas de 800 Hilos',
    desc: 'Algodón egipcio peinado que acaricia la piel con suavidad de nube térmica.'
  },
  {
    title: 'Aromaterapia de Habitación',
    desc: 'Aceites esenciales de lavanda y cedro andino difundidos antes de tu llegada.'
  },
  {
    title: 'Tina de Piedra Volcánica',
    desc: 'Baños de inmersión con sales minerales y sales botánicas de romero.'
  },
  {
    title: 'Infusión Nocturna de Cortesía',
    desc: 'Té orgánico cosechado en nuestro huerto servido cada noche en tu suite.'
  }
];

const sanctuaryCorners = [
  {
    id: 'patio',
    name: 'El Patio de Orquídeas',
    desc: 'Un oasis de sombra fresca, helechos arborescentes y murmullo de agua cristalina para leer en absoluta quietud.',
    image: 'https://images.unsplash.com/photo-1600566753086-00f18fb6b3ea?auto=format&fit=crop&w=1200&q=88',
    tag: 'Silencio y Naturaleza'
  },
  {
    id: 'alberca',
    name: 'Alberca de Piedra Climatizada',
    desc: 'Piscina de inmersión en piedra termal volcánica rodeada de enredaderas y reposeras de madera de teca.',
    image: 'https://images.unsplash.com/photo-1571896349842-33c89424de2d?auto=format&fit=crop&w=1200&q=88',
    tag: 'Bienestar Hidrotermal'
  },
  {
    id: 'cava',
    name: 'Cava de Vinos del Valle',
    desc: 'Colección subterránea de 120 etiquetas biodinámicas con catas personalizadas a la luz de las velas.',
    image: 'https://images.unsplash.com/photo-1510812431401-41d2bd2722f3?auto=format&fit=crop&w=1200&q=88',
    tag: 'Gastronomía de Autor'
  },
  {
    id: 'huerto',
    name: 'Huerto Terapéutico & Té',
    desc: 'Plantas medicinales y aromáticas de donde nuestro botánico recolecta las infusiones de tu descanso.',
    image: 'https://images.unsplash.com/photo-1585320806297-9794b3e4eeae?auto=format&fit=crop&w=1200&q=88',
    tag: 'Origen Orgánico'
  }
];

const testimonials = [
  {
    author: 'Elena & Carlos R.',
    stay: 'Suite Botánica · Escapada de Aniversario',
    quote: '«Desde el momento en que entras, el aroma a cedro y la brisa te transportan a otro estado de paz. Dormimos mejor que en ningún otro hotel en años. La carta de almohadas es un detalle exquisito.»',
    rating: '5.0 / 5.0',
    tags: ['Sueño 5/5', 'Spa 5/5', 'Privacidad 5/5']
  },
  {
    author: 'Ignacio M.',
    stay: 'Habitación Deluxe · Retiro de Escritura',
    quote: '«El silencio del patio de orquídeas y el café de origen por la mañana me permitieron concentrarme y desconectar por completo. El equipo de concierge atiende con un cariño genuino.»',
    rating: '5.0 / 5.0',
    tags: ['Calma 5/5', 'Café de Autor 5/5', 'Concierge 5/5']
  },
  {
    author: 'Sofía V.',
    stay: 'Gran Villa Botánica · Fin de Semana Familiar',
    quote: '«La piscina privada de piedra y el desayuno gourmet en la terraza superaron toda expectativa. Es un verdadero santuario dentro de la ciudad.»',
    rating: '4.9 / 5.0',
    tags: ['Exclusividad 5/5', 'Desayuno 5/5']
  }
];
---

<BaseLayout title="Casa Botánica — Hotel Boutique & Santuario de Bienestar" showStickyBar={true}>
  <!-- 1. Hero Inmersivo Editorial -->
  <section id="inicio" class="relative min-h-[85vh] md:min-h-[90vh] overflow-hidden bg-[#07241c] text-white flex items-center">
    <BotanicalParticles />

    <img
      src="https://images.unsplash.com/photo-1600607687920-4e2a09cf159d?auto=format&fit=crop&w=2400&q=90"
      alt="Terraza y jardines iluminados de Casa Botánica al atardecer"
      class="absolute inset-0 h-full w-full object-cover scale-105 transition-transform duration-[10000ms] hover:scale-100 opacity-90"
      fetchpriority="high"
    />
    <div class="absolute inset-0 bg-gradient-to-r from-[#041c14]/95 via-[#041c14]/75 to-transparent"></div>
    <div class="absolute inset-0 bg-gradient-to-t from-[#041c14] via-transparent to-black/30"></div>

    <div class="shell relative z-20 py-16 sm:py-20">
      <div class="max-w-3xl">
        <div class="fade-up inline-flex items-center gap-2.5 rounded-full border border-gold/40 bg-forest/70 px-4 py-1.5 backdrop-blur-md mb-6">
          <span class="h-2 w-2 rounded-full bg-emerald-400"></span>
          <span class="text-xs font-bold uppercase tracking-widest text-gold-soft">
            Santuario Abierto · Experiencia Sensorial 2026
          </span>
        </div>

        <h1 class="fade-up display text-4xl sm:text-5xl md:text-6xl lg:text-7xl font-medium leading-[1.02] tracking-tight text-white">
          Donde el silencio, la naturaleza y el descanso se encuentran.
        </h1>

        <p class="fade-up mt-6 max-w-xl text-sm sm:text-base md:text-lg text-white/85 leading-relaxed font-light">
          Un hotel boutique concebido como un refugio de hospitalidad cálida. Desconecta entre sábanas de ensueño, aromaterapia orgánica y jardines secretos.
        </p>

        <div class="fade-up mt-8 flex flex-wrap items-center gap-4">
          <a
            href="#reservar"
            class="btn-gold rounded-xl px-7 py-3.5 text-xs sm:text-sm font-bold tracking-widest uppercase text-forest shadow-xl"
          >
            Explorar Disponibilidad
          </a>
          <button
            type="button"
            data-open-sensory-modal
            class="flex items-center gap-2 rounded-xl border border-white/25 bg-white/10 px-6 py-3.5 text-xs sm:text-sm font-semibold tracking-wider text-white backdrop-blur-md transition hover:bg-white/20 hover:border-gold"
          >
            <span>Carta de Almohadas & Aromas</span>
          </button>
        </div>
      </div>
    </div>

    <div class="absolute bottom-6 right-8 z-20 hidden lg:flex items-center gap-6 text-xs text-white/70">
      <span class="flex items-center gap-2"><span class="text-gold">✦</span> Algodón 800 Hilos</span>
      <span class="flex items-center gap-2"><span class="text-gold">✦</span> Menú de Aromaterapia</span>
      <span class="flex items-center gap-2"><span class="text-gold">✦</span> Tina de Piedra Volcánica</span>
    </div>
  </section>

  <!-- 2. El Arte del Descanso -->
  <section id="descanso" class="shell py-20 lg:py-28">
    <div class="grid items-center gap-12 lg:grid-cols-[1.1fr_0.9fr]">
      <div class="fade-up">
        <span class="eyebrow">La Esencia de Casa Botánica</span>
        <h2 class="display mt-3 text-3xl sm:text-4xl md:text-5xl font-medium leading-[1.05] text-forest">
          Diseñado para envolverte en calma absoluta.
        </h2>
        <span class="mt-5 block h-0.5 w-16 bg-gold"></span>
        <p class="mt-6 text-sm md:text-base leading-relaxed text-stone-600 font-normal">
          Creemos que el verdadero lujo no radica en la ostentación, sino en la sensación de quitarse los zapatos, inhalar el aroma fresco del bosque y descansar en una cama que parece abrazarte. Cada elemento ha sido seleccionado artesanalmente para favorecer tu descanso profundo.
        </p>

        <div class="mt-8 grid gap-4 sm:grid-cols-2">
          {comfortHighlights.map(item => (
            <div class="rounded-2xl border border-stone-200/80 bg-paper p-5 transition hover:border-gold/50 hover:shadow-md">
              <span class="text-gold font-bold text-xs uppercase tracking-wider block">✦ Bienestar</span>
              <h3 class="display text-lg font-semibold text-forest mt-1.5">{item.title}</h3>
              <p class="mt-1 text-xs text-stone-500 leading-relaxed">{item.desc}</p>
            </div>
          ))}
        </div>

        <div class="mt-8 flex items-center gap-4">
          <button
            type="button"
            data-open-sensory-modal
            class="btn-gold rounded-xl px-6 py-3.5 text-xs sm:text-sm font-bold tracking-wider text-forest uppercase"
          >
            Personalizar mi Carta de Almohadas
          </button>
        </div>
      </div>

      <div class="fade-up relative">
        <div class="relative overflow-hidden rounded-3xl shadow-2xl border border-gold/30 aspect-[4/3] md:aspect-[3/4] lg:aspect-[4/3]">
          <img
            src="https://images.unsplash.com/photo-1618773928121-c32242e63f39?auto=format&fit=crop&w=1200&q=90"
            alt="Suite Botánica y detalle de cama y sábanas de lujo"
            class="h-full w-full object-cover"
          />
          <div class="absolute bottom-4 left-4 right-4 sm:bottom-6 sm:left-6 sm:right-6 rounded-2xl bg-paper/95 p-4 sm:p-5 backdrop-blur-md border border-gold/30 shadow-lg">
            <span class="eyebrow text-gold">Ritual del Buen Dormir</span>
            <p class="display text-lg sm:text-xl text-forest mt-1">«El descanso no es una pausa, es una reconexión.»</p>
            <p class="mt-1 text-xs text-stone-500">Suite Botánica · Selección de aromaterapia incluida</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 3. Sobre Nosotros -->
  <section id="nosotros" class="overflow-hidden border-y border-stone-200/70 bg-paper py-20 lg:py-28">
    <div class="shell grid items-center gap-14 lg:grid-cols-[1.05fr_0.95fr]">
      <div class="fade-up relative min-h-[440px] sm:min-h-[560px]">
        <div class="absolute inset-x-0 top-0 h-[78%] overflow-hidden rounded-3xl border border-gold/25 shadow-2xl sm:right-20">
          <img
            src="/images/about-team.webp"
            alt="Equipo de Casa Botánica preparando la bienvenida en el patio interior"
            loading="lazy"
            class="h-full w-full object-cover"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-forest/35 via-transparent to-transparent"></div>
        </div>

        <div class="absolute bottom-0 right-0 w-[48%] overflow-hidden rounded-3xl border-4 border-paper bg-paper shadow-2xl sm:w-[44%]">
          <img
            src="/images/about-ritual.webp"
            alt="Ritual de bienvenida con cerámica artesanal e infusión botánica"
            loading="lazy"
            class="aspect-[4/5] h-full w-full object-cover"
          />
        </div>

        <div class="absolute bottom-5 left-5 max-w-[58%] rounded-2xl border border-white/20 bg-[#08241b]/92 p-4 text-white shadow-xl backdrop-blur-md sm:bottom-8 sm:left-8 sm:max-w-xs sm:p-5">
          <span class="text-[0.6rem] font-bold uppercase tracking-[0.2em] text-gold-light">Nuestra forma de recibir</span>
          <p class="display mt-1 text-lg leading-tight sm:text-xl">Cada detalle comienza antes de tu llegada.</p>
        </div>
      </div>

      <div class="fade-up lg:pl-4">
        <span class="eyebrow">Sobre Nosotros</span>
        <h2 class="display mt-3 text-3xl font-medium leading-[1.05] text-forest sm:text-4xl md:text-5xl">
          Una casa nacida para devolverle tiempo al descanso.
        </h2>
        <span class="mt-5 block h-0.5 w-16 bg-gold"></span>

        <div class="mt-6 space-y-4 text-sm leading-relaxed text-stone-600 md:text-base">
          <p>
            Casa Botánica nació de una idea sencilla: la hospitalidad más memorable no necesita imponerse, necesita escuchar. Por eso transformamos una casa de carácter patrimonial en un refugio íntimo donde la arquitectura, la vegetación y el servicio se mueven al ritmo de cada huésped.
          </p>
          <p>
            Somos un equipo de anfitriones, artesanos y amantes de la naturaleza. Trabajamos con cerámica local, productos de temporada y rituales de bienestar personalizados para que cada estadía se sienta cercana, serena y genuinamente propia.
          </p>
        </div>

        <blockquote class="mt-7 border-l-2 border-gold pl-5">
          <p class="display text-2xl italic leading-tight text-forest">«Más que alojar, cuidamos la forma en que llegas, descansas y recuerdas.»</p>
        </blockquote>

        <div class="mt-8 grid gap-3 sm:grid-cols-3">
          <div class="rounded-2xl border border-stone-200/80 bg-ivory p-4">
            <span class="text-gold">✦</span>
            <h3 class="mt-2 text-xs font-bold uppercase tracking-wider text-forest">Hospitalidad atenta</h3>
            <p class="mt-1 text-xs leading-relaxed text-stone-500">Presencia cercana, discreta y disponible cuando la necesitas.</p>
          </div>
          <div class="rounded-2xl border border-stone-200/80 bg-ivory p-4">
            <span class="text-gold">✦</span>
            <h3 class="mt-2 text-xs font-bold uppercase tracking-wider text-forest">Naturaleza cotidiana</h3>
            <p class="mt-1 text-xs leading-relaxed text-stone-500">Plantas, aromas y materiales honestos integrados al descanso.</p>
          </div>
          <div class="rounded-2xl border border-stone-200/80 bg-ivory p-4">
            <span class="text-gold">✦</span>
            <h3 class="mt-2 text-xs font-bold uppercase tracking-wider text-forest">Lujo con propósito</h3>
            <p class="mt-1 text-xs leading-relaxed text-stone-500">Menos exceso, más calidad, calma y experiencias con sentido.</p>
          </div>
        </div>

        <a href="/habitaciones" class="btn-gold mt-8 rounded-xl px-6 py-3.5 text-xs font-bold tracking-wider text-forest uppercase">
          Conocer nuestros refugios →
        </a>
      </div>
    </div>
  </section>

  <!-- 4. Habitaciones & Suites Destacadas -->
  <section id="habitaciones" class="bg-[#efebe2] py-20 lg:py-28 transition-colors">
    <div class="shell">
      <div class="fade-up flex flex-wrap items-end justify-between gap-6">
        <div>
          <span class="eyebrow">Habitaciones & Refugios</span>
          <h2 class="display mt-2 text-3xl sm:text-4xl md:text-5xl font-medium text-forest">
            Nuestros Espacios de Descanso
          </h2>
        </div>
        <a
          href="/habitaciones"
          class="inline-flex items-center gap-2 text-xs font-bold tracking-widest text-forest uppercase hover:text-gold transition"
        >
          <span>Ver catálogo completo ({ROOMS_CATALOG.length} suites)</span>
          <span>→</span>
        </a>
      </div>

      <div class="mt-12 grid gap-8 md:grid-cols-2 lg:grid-cols-3">
        {featuredRooms.map((room) => (
          <article class="room-card group fade-up overflow-hidden rounded-3xl border border-stone-200/80 bg-paper soft-shadow flex flex-col justify-between">
            <div>
              <div class="relative h-64 sm:h-72 overflow-hidden">
                <img
                  src={room.image}
                  alt={room.name}
                  loading="lazy"
                  class="h-full w-full object-cover transition duration-700 group-hover:scale-105"
                />
                <span class="absolute left-4 top-4 rounded-full bg-paper/95 px-3.5 py-1.5 text-[0.65rem] font-bold uppercase tracking-wider text-forest backdrop-blur-md shadow">
                  {room.tag}
                </span>
                <button
                  type="button"
                  data-open-sensory-modal
                  class="absolute right-4 top-4 grid h-9 w-9 place-items-center rounded-full bg-forest/70 text-gold backdrop-blur-md hover:bg-forest transition text-xs font-bold"
                  title="Carta de confort para esta habitación"
                >
                  ✦
                </button>
              </div>

              <div class="p-6 md:p-7">
                <h3 class="display text-2xl md:text-3xl font-semibold text-forest">
                  {room.name}
                </h3>
                <p class="mt-2 text-xs text-stone-500 font-medium">
                  {room.capacity} · {room.bed} · {room.size}
                </p>
                <p class="mt-4 text-xs leading-relaxed text-stone-600 line-clamp-2 font-normal">
                  {room.description}
                </p>
              </div>
            </div>

            <div class="p-6 md:p-7 pt-0 border-t border-stone-200/60 mt-4 flex items-end justify-between">
              <div>
                <span class="text-[0.62rem] uppercase tracking-widest text-stone-500 font-semibold block">Tarifa por noche</span>
                <p class="display text-2xl md:text-3xl font-bold text-forest">
                  ${room.priceCLP.toLocaleString('es-CL')} <span class="font-sans text-xs font-normal text-stone-500">CLP</span>
                </p>
              </div>
              <a
                href={`/habitaciones`}
                class="btn-gold rounded-xl px-5 py-2.5 text-xs font-bold tracking-wider text-forest uppercase"
              >
                Reservar →
              </a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- 5. Quiz Interactivo -->
  <section id="personalizar" class="shell py-20 lg:py-28">
    <div class="fade-up">
      <ComfortQuiz />
    </div>
  </section>

  <!-- 6. Experiencias Sensoriales -->
  <section id="experiencias" class="relative overflow-hidden bg-forest py-20 text-white lg:py-28">
    <div class="absolute inset-0 opacity-15 [background-image:radial-gradient(circle_at_20%_20%,#c89c52_0,transparent_28%),radial-gradient(circle_at_90%_70%,#c89c52_0,transparent_22%)]"></div>

    <div class="shell relative grid items-center gap-12 lg:grid-cols-2">
      <div class="fade-up grid grid-cols-2 gap-4">
        <div class="space-y-4">
          <img
            src="https://images.unsplash.com/photo-1544161515-4ab6ce6db874?auto=format&fit=crop&w=800&q=85"
            alt="Masaje botánico relajante"
            loading="lazy"
            class="h-64 sm:h-72 w-full rounded-3xl object-cover shadow-xl"
          />
          <div class="rounded-2xl border border-gold/20 bg-forest-dark/70 p-4">
            <b class="text-xs text-gold-light">Spa & Piedras Volcánicas</b>
            <p class="text-xs text-white/70 mt-1">Masajes terapéuticos a la carta.</p>
          </div>
        </div>

        <div class="space-y-4 pt-8">
          <div class="rounded-2xl border border-gold/20 bg-forest-dark/70 p-4">
            <b class="text-xs text-gold-light">Cata de Vinos Orgánicos</b>
            <p class="text-xs text-white/70 mt-1">Cepas del valle con sommelier.</p>
          </div>
          <img
            src="https://images.unsplash.com/photo-1506377247377-2a5b3b417ebb?auto=format&fit=crop&w=800&q=85"
            alt="Cata de vinos en viñedos cercanos"
            loading="lazy"
            class="h-64 sm:h-72 w-full rounded-3xl object-cover shadow-xl"
          />
        </div>
      </div>

      <div class="fade-up lg:pl-8">
        <span class="eyebrow text-gold-soft">Momentos Inolvidables</span>
        <h2 class="display mt-3 text-3xl sm:text-4xl md:text-5xl font-medium leading-tight text-white">
          Experiencias que reconectan tu espíritu.
        </h2>
        <p class="mt-5 text-sm md:text-base leading-relaxed text-white/75 font-light">
          Tu estadía se extiende más allá de la habitación. Diseñamos vivencias botánicas, sesiones de spa privadas, desayunos flotantes y recorridos en viñedos sustentables para que cada instante tenga significado.
        </p>

        <div class="mt-8 grid grid-cols-2 gap-3.5 text-xs font-semibold">
          <div class="rounded-xl border border-white/10 bg-white/5 p-3.5">
            <span class="text-gold">✦</span> Masajes a 4 Manos
          </div>
          <div class="rounded-xl border border-white/10 bg-white/5 p-3.5">
            <span class="text-gold">✦</span> Desayuno en la Cama
          </div>
          <div class="rounded-xl border border-white/10 bg-white/5 p-3.5">
            <span class="text-gold">✦</span> Ruta Privada de Vinos
          </div>
          <div class="rounded-xl border border-white/10 bg-white/5 p-3.5">
            <span class="text-gold">✦</span> Noches con Velas & Tina
          </div>
        </div>

        <div class="mt-8 flex flex-wrap gap-4">
          <a
            href="/reserva/experiencias"
            class="btn-gold rounded-xl px-7 py-3.5 text-xs sm:text-sm font-bold tracking-widest uppercase text-forest"
          >
            Ver Experiencias
          </a>
          <button
            type="button"
            data-open-concierge
            class="rounded-xl border border-white/30 bg-white/5 px-6 py-3.5 text-xs sm:text-sm font-semibold text-white transition hover:bg-white/10"
          >
            Consultar al Concierge
          </button>
        </div>
      </div>
    </div>
  </section>

  <!-- 7. Rincones Secretos -->
  <section id="santuario" class="shell py-20 lg:py-28">
    <div class="fade-up text-center max-w-2xl mx-auto">
      <span class="eyebrow">Exploración & Paz</span>
      <h2 class="display mt-2 text-3xl sm:text-4xl md:text-5xl font-medium text-forest">
        Los Rincones Secretos del Hotel
      </h2>
      <p class="mt-3 text-sm text-stone-600">
        Espacios íntimos diseñados para perder la noción del tiempo y entregarse a la lectura, el vino y la calma.
      </p>
    </div>

    <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {sanctuaryCorners.map(corner => (
        <div class="fade-up overflow-hidden rounded-3xl border border-stone-200/80 bg-paper soft-shadow flex flex-col justify-between group">
          <div class="relative h-52 sm:h-56 overflow-hidden">
            <img
              src={corner.image}
              alt={corner.name}
              loading="lazy"
              class="h-full w-full object-cover transition-transform duration-700 group-hover:scale-105"
            />
            <span class="absolute left-3 top-3 rounded-full bg-paper/90 px-3 py-1 text-[0.62rem] font-bold uppercase tracking-wider text-forest backdrop-blur-md">
              {corner.tag}
            </span>
          </div>
          <div class="p-5 flex-1 flex flex-col justify-between">
            <div>
              <h3 class="display text-xl font-semibold text-forest">{corner.name}</h3>
              <p class="mt-2 text-xs leading-relaxed text-stone-500 font-normal">{corner.desc}</p>
            </div>
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- 8. Testimonios -->
  <section class="bg-forest py-20 text-white">
    <div class="shell">
      <div class="fade-up text-center max-w-2xl mx-auto">
        <span class="eyebrow text-gold-soft">Historias de Huéspedes</span>
        <h2 class="display mt-2 text-3xl sm:text-4xl md:text-5xl font-medium text-white">
          La Voz de Quienes Descansaron Aquí
        </h2>
      </div>

      <div class="mt-12 grid gap-8 md:grid-cols-3">
        {testimonials.map(t => (
          <div class="fade-up rounded-3xl border border-gold/20 bg-forest-dark/60 p-7 flex flex-col justify-between shadow-xl backdrop-blur-md">
            <div>
              <div class="flex items-center justify-between text-gold">
