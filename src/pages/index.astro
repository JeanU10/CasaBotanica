---
import '../styles/global.css';

const rooms = [
  {
    name: 'Suite Botánica',
    meta: '2 huéspedes · 1 cama King · 32 m²',
    price: '$145.000',
    image: 'https://images.unsplash.com/photo-1618773928121-c32242e63f39?auto=format&fit=crop&w=1200&q=88',
    tag: 'La favorita'
  },
  {
    name: 'Habitación Deluxe',
    meta: '2 huéspedes · 1 cama Queen · 28 m²',
    price: '$115.000',
    image: 'https://images.unsplash.com/photo-1590490360182-c33d57733427?auto=format&fit=crop&w=1200&q=88',
    tag: 'Vista al jardín'
  },
  {
    name: 'Habitación Superior',
    meta: '2 huéspedes · 1 cama Queen · 24 m²',
    price: '$95.000',
    image: 'https://images.unsplash.com/photo-1566665797739-1674de7a421a?auto=format&fit=crop&w=1200&q=88',
    tag: 'Escapada perfecta'
  }
];

const benefits = [
  ['✦', 'Atención personalizada', 'Un equipo cercano para cuidar cada momento.'],
  ['♧', 'Bienestar y relajación', 'Spa, masajes y espacios creados para ti.'],
  ['⌖', 'Experiencias locales', 'Rutas y actividades con anfitriones locales.'],
  ['◇', 'Reserva segura', 'Tus datos y tu pago siempre protegidos.']
];
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content="Casa Botánica, un hotel boutique donde la naturaleza, la calma y el diseño se encuentran." />
    <meta name="theme-color" content="#0b2f24" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;500;600&family=Manrope:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <title>Casa Botánica — Hotel Boutique</title>
  </head>
  <body>
    <header class="fixed inset-x-0 top-0 z-50 border-b border-white/10 text-white transition-all duration-300" id="site-header">
      <div class="shell flex h-20 items-center justify-between gap-8 lg:h-24">
        <a href="#inicio" class="group flex items-center gap-3" aria-label="Casa Botánica, inicio">
          <span class="grid h-10 w-10 place-items-center rounded-full border border-gold/70 text-2xl text-gold transition group-hover:rotate-12">✤</span>
          <span class="leading-none">
            <span class="display block text-[1.3rem] tracking-wide">CASA BOTÁNICA</span>
            <span class="mt-1 block text-[.56rem] font-semibold tracking-[.3em] text-gold-soft">HOTEL BOUTIQUE</span>
          </span>
        </a>

        <nav class="hidden items-center gap-8 text-sm font-medium xl:flex" aria-label="Navegación principal">
          <a class="transition hover:text-gold-soft" href="#habitaciones">Habitaciones</a>
          <a class="transition hover:text-gold-soft" href="#experiencias">Experiencias</a>
          <a class="transition hover:text-gold-soft" href="#gastronomia">Gastronomía</a>
          <a class="transition hover:text-gold-soft" href="#hotel">El hotel</a>
          <a class="transition hover:text-gold-soft" href="#destino">Destino</a>
        </nav>

        <div class="flex items-center gap-3">
          <a href="/habitaciones" class="hidden rounded-xl border border-gold/60 bg-forest px-5 py-3 text-xs font-bold tracking-[.14em] transition hover:bg-forest-light sm:block">RESERVAR AHORA</a>
          <button id="menu-button" class="grid h-11 w-11 place-items-center rounded-full border border-white/25 xl:hidden" aria-label="Abrir menú" aria-expanded="false">
            <span class="text-xl">☰</span>
          </button>
        </div>
      </div>
      <nav id="mobile-menu" class="glass hidden border-t border-white/10 px-6 py-5 xl:hidden" aria-label="Navegación móvil">
        <div class="mx-auto grid max-w-xl gap-4 text-center text-sm">
          <a href="#habitaciones">Habitaciones</a><a href="#experiencias">Experiencias</a><a href="#gastronomia">Gastronomía</a><a href="#hotel">El hotel</a><a href="#destino">Destino</a>
        </div>
      </nav>
    </header>

    <main>
      <section id="inicio" class="relative min-h-[760px] overflow-hidden bg-forest text-white md:min-h-[840px]">
        <img src="https://images.unsplash.com/photo-1600607687920-4e2a09cf159d?auto=format&fit=crop&w=2200&q=90" alt="Terraza iluminada de Casa Botánica al atardecer" class="absolute inset-0 h-full w-full object-cover" fetchpriority="high" />
        <div class="absolute inset-0 bg-[linear-gradient(90deg,rgba(4,24,18,.88)_0%,rgba(4,24,18,.5)_43%,rgba(4,24,18,.18)_75%),linear-gradient(0deg,rgba(4,24,18,.5),transparent_50%)]"></div>
        <div class="shell relative z-10 flex min-h-[760px] items-center pt-24 md:min-h-[840px]">
          <div class="max-w-3xl pb-20 pt-12">
            <p class="eyebrow mb-6 text-gold-soft">Bienvenido a Casa Botánica</p>
            <h1 class="display max-w-3xl text-6xl font-medium leading-[.88] tracking-[-.035em] sm:text-7xl md:text-[6.7rem]">Una estadía que recordarás.</h1>
            <p class="mt-8 max-w-lg text-base leading-7 text-white/80 md:text-lg">Un hotel boutique en el corazón de la ciudad, donde cada detalle está pensado para ti.</p>
            <a href="#hotel" class="mt-9 inline-flex items-center gap-8 rounded-full border border-gold/70 bg-forest/80 px-7 py-4 text-xs font-bold tracking-[.13em] transition hover:bg-forest">DESCUBRIR EL HOTEL <span class="text-lg text-gold">→</span></a>
          </div>
        </div>
        <div class="absolute bottom-5 right-5 z-10 hidden items-center gap-3 text-xs text-white/70 md:flex"><span class="h-px w-10 bg-gold"></span> Santiago · Chile</div>
      </section>

      <section id="reservar" class="relative z-20 -mt-16 px-4">
        <form id="booking-form" class="soft-shadow mx-auto grid max-w-5xl overflow-hidden rounded-2xl bg-paper md:grid-cols-[1fr_1fr_1fr_1.35fr]" aria-label="Buscar disponibilidad">
          <label class="border-b border-stone-200 px-6 py-5 md:border-b-0 md:border-r">
            <span class="text-[.62rem] font-bold tracking-[.14em] text-stone-500">ENTRADA</span>
            <input name="entrada" type="date" value="2026-08-12" class="mt-2 w-full bg-transparent text-sm font-semibold outline-none" required />
          </label>
          <label class="border-b border-stone-200 px-6 py-5 md:border-b-0 md:border-r">
            <span class="text-[.62rem] font-bold tracking-[.14em] text-stone-500">SALIDA</span>
            <input name="salida" type="date" value="2026-08-15" class="mt-2 w-full bg-transparent text-sm font-semibold outline-none" required />
          </label>
          <label class="border-b border-stone-200 px-6 py-5 md:border-b-0 md:border-r">
            <span class="text-[.62rem] font-bold tracking-[.14em] text-stone-500">HUÉSPEDES</span>
            <select name="huespedes" class="mt-2 w-full bg-transparent text-sm font-semibold outline-none">
              <option>2 adultos</option><option>1 adulto</option><option>3 adultos</option><option>Familia · 4 huéspedes</option>
            </select>
          </label>
          <div class="p-3"><button class="h-full min-h-16 w-full rounded-xl bg-forest px-5 text-xs font-bold tracking-[.12em] text-white transition hover:bg-forest-light">BUSCAR DISPONIBILIDAD</button></div>
        </form>
      </section>

      <section id="hotel" class="shell grid items-center gap-12 py-24 lg:grid-cols-[.78fr_1.22fr] lg:py-32">
        <div class="fade-up lg:pr-10">
          <p class="eyebrow">Experiencias únicas</p>
          <h2 class="display mt-5 text-5xl font-medium leading-[.98] md:text-6xl">Hospitalidad que nace de los detalles</h2>
          <span class="mt-7 block h-px w-12 bg-gold"></span>
          <p class="mt-7 max-w-md text-sm leading-7 text-stone-600">En Casa Botánica, la elegancia se encuentra con la calidez. Disfruta de un servicio personalizado, espacios llenos de historia y momentos que harán de tu viaje algo inolvidable.</p>
          <a href="#experiencias" class="mt-8 inline-flex items-center gap-5 text-xs font-bold tracking-[.13em] text-forest">CONOCE NUESTRA HISTORIA <span class="text-gold">→</span></a>
        </div>
        <div class="fade-up relative overflow-hidden rounded-2xl">
          <img src="https://images.unsplash.com/photo-1600566753086-00f18fb6b3ea?auto=format&fit=crop&w=1500&q=90" alt="Salón interior del hotel con vegetación y luz cálida" loading="lazy" class="h-[430px] w-full object-cover md:h-[520px]" />
          <div class="absolute bottom-5 left-5 rounded-xl bg-paper/95 px-5 py-4 backdrop-blur"><p class="display text-2xl">Un refugio urbano</p><p class="mt-1 text-xs text-stone-500">Diseño, naturaleza y calma</p></div>
        </div>
      </section>

      <section id="habitaciones" class="bg-[#f0ece4] py-24 lg:py-28">
        <div class="shell">
          <div class="fade-up flex items-end justify-between gap-6">
            <div><p class="eyebrow">Descansa con estilo</p><h2 class="display mt-3 text-5xl font-medium md:text-6xl">Nuestras habitaciones</h2></div>
            <a href="#reservar" class="hidden text-xs font-bold tracking-[.12em] text-forest sm:inline-flex">VER TODAS &nbsp; →</a>
          </div>
          <div class="mt-12 grid gap-7 md:grid-cols-2 lg:grid-cols-3">
            {rooms.map((room) => (
              <article class="room-card fade-up overflow-hidden rounded-2xl bg-paper">
                <div class="relative h-72 overflow-hidden"><img src={room.image} alt={room.name} loading="lazy" class="h-full w-full object-cover" /><span class="absolute left-5 top-5 rounded-full bg-paper/90 px-3 py-1.5 text-[.58rem] font-bold uppercase tracking-[.13em] text-forest backdrop-blur">{room.tag}</span></div>
                <div class="p-6">
                  <h3 class="display text-3xl font-semibold">{room.name}</h3>
                  <p class="mt-2 text-xs text-stone-500">{room.meta}</p>
                  <div class="mt-7 flex items-end justify-between border-t border-stone-200 pt-5"><div><p class="text-[.62rem] uppercase tracking-widest text-stone-500">Desde</p><p class="display text-3xl">{room.price}<span class="ml-1 font-sans text-[.65rem] text-stone-500">/ noche</span></p></div><a href="#reservar" aria-label={`Reservar ${room.name}`} class="grid h-11 w-11 place-items-center rounded-full border border-gold text-lg text-forest transition hover:bg-forest hover:text-white">→</a></div>
                </div>
              </article>
            ))}
          </div>
        </div>
      </section>

      <section id="experiencias" class="relative overflow-hidden bg-forest py-24 text-white lg:py-32">
        <div class="absolute inset-0 opacity-15 [background-image:radial-gradient(circle_at_20%_20%,#c89c52_0,transparent_28%),radial-gradient(circle_at_90%_70%,#c89c52_0,transparent_22%)]"></div>
        <div class="shell relative grid items-center gap-12 lg:grid-cols-2">
          <div class="fade-up grid grid-cols-2 gap-4">
            <img src="https://images.unsplash.com/photo-1544161515-4ab6ce6db874?auto=format&fit=crop&w=900&q=85" alt="Experiencia de masaje" loading="lazy" class="mt-12 h-80 w-full rounded-2xl object-cover" />
            <img src="https://images.unsplash.com/photo-1510812431401-41d2bd2722f3?auto=format&fit=crop&w=900&q=85" alt="Cata de vinos local" loading="lazy" class="h-80 w-full rounded-2xl object-cover" />
          </div>
          <div class="fade-up lg:pl-12">
            <p class="eyebrow text-gold-soft">Más que una estadía</p>
            <h2 class="display mt-4 text-5xl font-medium leading-none md:text-6xl">Momentos que se quedan contigo</h2>
            <p class="mt-7 max-w-lg leading-7 text-white/70">Descubre bienestar, gastronomía de estación y rutas privadas diseñadas por nuestro concierge. Cada experiencia nace del paisaje y de las personas que le dan vida.</p>
            <div class="mt-10 grid grid-cols-2 gap-y-7 text-sm"><p>✦ Spa & bienestar</p><p>✦ Cocina de autor</p><p>✦ Viñedos privados</p><p>✦ Rutas culturales</p></div>
            <a href="#reservar" class="mt-10 inline-flex rounded-full bg-gold px-7 py-4 text-xs font-bold tracking-[.12em] text-forest transition hover:bg-gold-soft">EXPLORAR EXPERIENCIAS</a>
          </div>
        </div>
      </section>

      <section id="gastronomia" class="shell py-24 lg:py-28">
        <div class="fade-up rounded-3xl bg-paper p-8 soft-shadow md:p-12">
          <div class="grid divide-y divide-stone-200 md:grid-cols-4 md:divide-x md:divide-y-0">
            {benefits.map(([icon, title, text]) => <div class="px-4 py-6 first:pl-0 last:pr-0 md:py-2"><span class="text-3xl text-gold">{icon}</span><h3 class="mt-4 font-semibold text-forest">{title}</h3><p class="mt-2 text-xs leading-5 text-stone-500">{text}</p></div>)}
          </div>
        </div>
      </section>

      <section id="destino" class="relative min-h-[480px] overflow-hidden text-white">
        <img src="https://images.unsplash.com/photo-1470252649378-9c29740c9fa8?auto=format&fit=crop&w=2200&q=88" alt="Paisaje de viñedos al amanecer" loading="lazy" class="absolute inset-0 h-full w-full object-cover" />
        <div class="absolute inset-0 bg-forest/65"></div>
        <div class="shell relative flex min-h-[480px] items-center justify-center py-16 text-center">
          <div class="fade-up max-w-2xl"><p class="eyebrow text-gold-soft">Tu próximo recuerdo empieza aquí</p><h2 class="display mt-4 text-5xl font-medium md:text-7xl">Vive Casa Botánica</h2><p class="mx-auto mt-6 max-w-lg text-sm leading-7 text-white/75">Permítenos crear una estadía a tu medida, llena de calma, sabores y descubrimientos.</p><a href="#reservar" class="mt-8 inline-flex rounded-full bg-paper px-8 py-4 text-xs font-bold tracking-[.13em] text-forest">RESERVAR MI ESTADÍA</a></div>
        </div>
      </section>
    </main>

    <footer class="bg-[#06251c] py-14 text-white">
      <div class="shell grid gap-10 md:grid-cols-[1.1fr_1fr_1fr]">
        <div><div class="display text-2xl">✤ &nbsp; CASA BOTÁNICA</div><p class="mt-2 text-[.6rem] tracking-[.25em] text-gold-soft">HOTEL BOUTIQUE</p><p class="mt-5 max-w-xs text-xs leading-6 text-white/55">Un oasis de naturaleza, diseño y hospitalidad en el corazón de la ciudad.</p></div>
        <div><p class="eyebrow text-gold-soft">Contáctanos</p><div class="mt-5 space-y-3 text-xs text-white/65"><p>+56 9 1234 5678</p><p>hola@casabotanica.cl</p><p>Calle del Jardín 123, Centro Histórico</p></div></div>
        <div><p class="eyebrow text-gold-soft">Newsletter</p><p class="mt-5 text-xs text-white/60">Recibe ofertas exclusivas y novedades.</p><form id="newsletter-form" class="mt-4 flex overflow-hidden rounded-xl border border-white/20"><input type="email" placeholder="Tu correo electrónico" aria-label="Correo electrónico" class="min-w-0 flex-1 bg-transparent px-4 py-3 text-xs outline-none placeholder:text-white/35" required /><button class="w-12 bg-gold text-xl text-forest" aria-label="Suscribirse">→</button></form></div>
      </div>
      <div class="shell mt-12 flex flex-col gap-3 border-t border-white/10 pt-6 text-[.65rem] text-white/40 sm:flex-row sm:justify-between"><p>© 2026 Casa Botánica Hotel Boutique.</p><p>Privacidad &nbsp; · &nbsp; Términos y condiciones</p></div>
    </footer>

    <div id="toast" class="pointer-events-none fixed bottom-5 left-1/2 z-[60] -translate-x-1/2 translate-y-5 rounded-full bg-forest px-6 py-3 text-sm text-white opacity-0 shadow-xl transition-all duration-300" role="status"></div>

    <script>
      const header = document.querySelector('#site-header');
      const menuButton = document.querySelector('#menu-button');
      const mobileMenu = document.querySelector('#mobile-menu');
      const toast = document.querySelector('#toast');
      const showToast = (message: string) => {
        if (!(toast instanceof HTMLElement)) return;
        toast.textContent = message;
        toast.classList.remove('opacity-0', 'translate-y-5');
        window.setTimeout(() => toast.classList.add('opacity-0', 'translate-y-5'), 3200);
      };
      const updateHeader = () => header?.classList.toggle('glass', window.scrollY > 30);
      updateHeader(); window.addEventListener('scroll', updateHeader, { passive: true });
      menuButton?.addEventListener('click', () => {
        mobileMenu?.classList.toggle('hidden');
        const open = !mobileMenu?.classList.contains('hidden');
        menuButton.setAttribute('aria-expanded', String(open));
      });
      mobileMenu?.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => mobileMenu.classList.add('hidden')));
      document.querySelector('#booking-form')?.addEventListener('submit', (event) => { event.preventDefault(); window.location.href = '/habitaciones'; });
      document.querySelector('#newsletter-form')?.addEventListener('submit', (event) => { event.preventDefault(); showToast('¡Gracias! Pronto recibirás noticias de Casa Botánica.'); });
      const observer = new IntersectionObserver((entries) => entries.forEach((entry) => entry.target.classList.toggle('visible', entry.isIntersecting)), { threshold: .12 });
      document.querySelectorAll('.fade-up').forEach((el) => observer.observe(el));
    </script>
  </body>
</html>
