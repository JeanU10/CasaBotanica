---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Stepper from '../../components/Stepper.astro';
import { ROOMS_CATALOG } from '../../scripts/bookingStore';
---

<BaseLayout title="Habitaciones & Suites — Casa Botánica Hotel Boutique" showStickyBar={false}>
  <!-- Top Hero Banner -->
  <section class="relative min-h-[360px] md:min-h-[400px] overflow-hidden bg-forest text-white flex items-center">
    <img
      src="https://images.unsplash.com/photo-1600607687920-4e2a09cf159d?auto=format&fit=crop&w=2200&q=90"
      alt="Casa Botánica al atardecer"
      class="absolute inset-0 h-full w-full object-cover opacity-90"
    />
    <div class="absolute inset-0 bg-gradient-to-r from-[#041c14]/95 via-[#041c14]/75 to-transparent"></div>

    <div class="shell relative z-10 py-12">
      <div class="max-w-2xl">
        <span class="eyebrow text-gold-soft">Elige tu Refugio</span>
        <h1 class="display mt-3 text-4xl sm:text-5xl md:text-6xl font-medium text-white leading-tight">
          Habitaciones diseñadas para el descanso.
        </h1>
        <p class="mt-4 text-xs md:text-sm text-white/80 max-w-xl leading-relaxed font-light">
          Cada suite es un santuario individual con luz natural, maderas nobles, ropa de cama de 800 hilos y carta de aromaterapia personalizada.
        </p>
      </div>
    </div>
  </section>

  <!-- Funnel Stepper -->
  <Stepper current={1} />

  <!-- Catalog Section -->
  <section class="shell py-16 lg:py-24">
    <!-- Header & Category Quick Pills -->
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 border-b border-stone-200 pb-6">
      <div>
        <span class="eyebrow">Selección Exclusiva</span>
        <h2 class="display mt-1 text-3xl sm:text-4xl md:text-5xl font-medium text-forest">
          Suites Disponibles
        </h2>
        <p class="mt-2 text-xs md:text-sm text-stone-500">
          Todas nuestras tarifas incluyen desayuno gourmet a la carta y menú sensorial de almohadas.
        </p>
      </div>

      <!-- Quick Filter Pills -->
      <div class="flex flex-wrap items-center gap-2">
        <button data-filter="all" class="room-filter-pill rounded-full bg-forest px-4 py-2 text-xs font-bold text-white shadow-sm">
          Todas ({ROOMS_CATALOG.length})
        </button>
        <button data-filter="garden" class="room-filter-pill rounded-full border border-stone-200 bg-paper px-4 py-2 text-xs font-medium text-forest hover:bg-stone-100 transition">
          Vista Jardín
        </button>
        <button data-filter="stone-bath" class="room-filter-pill rounded-full border border-stone-200 bg-paper px-4 py-2 text-xs font-medium text-forest hover:bg-stone-100 transition">
          Tina de Piedra
        </button>
      </div>
    </div>

    <!-- Rooms List -->
    <div id="rooms-grid-container" class="mt-10 space-y-8">
      {ROOMS_CATALOG.map((room) => (
        <article
          data-room-card-id={room.id}
          class="room-card group overflow-hidden rounded-3xl border border-stone-200/80 bg-paper soft-shadow grid lg:grid-cols-[40%_1fr] transition-all"
        >
          <!-- Image Column -->
          <div class="relative min-h-[280px] md:min-h-[340px] overflow-hidden">
            <img
              src={room.image}
              alt={room.name}
              class="h-full w-full object-cover transition-transform duration-700 group-hover:scale-105"
            />
            <span class="absolute left-4 top-4 rounded-full bg-paper/95 px-3.5 py-1.5 text-[0.62rem] font-bold uppercase tracking-wider text-forest backdrop-blur-md shadow">
              {room.tag}
            </span>

            <button
              type="button"
              data-open-sensory-modal
              class="absolute right-4 top-4 grid h-9 w-9 place-items-center rounded-full bg-forest/70 text-gold backdrop-blur-md hover:bg-forest transition text-xs font-bold"
              title="Ver carta de almohadas y aromas para esta habitación"
            >
              ✦
            </button>
          </div>

          <!-- Content Column -->
          <div class="p-6 md:p-8 flex flex-col justify-between">
            <div>
              <div class="flex flex-wrap items-center justify-between gap-2">
                <span class="eyebrow text-gold font-bold">{room.view}</span>
                <span class="text-xs text-stone-500 font-semibold">{room.capacity} · {room.size}</span>
              </div>

              <h3 class="display mt-2 text-3xl md:text-4xl font-semibold text-forest">
                {room.name}
              </h3>
              <p class="mt-1 text-xs text-stone-500 font-medium">
                {room.subtitle}
              </p>

              <p class="mt-4 text-xs md:text-sm text-stone-600 leading-relaxed font-light">
                {room.description}
              </p>

              <!-- Amenities Pills -->
              <div class="mt-6 flex flex-wrap gap-2">
                {room.amenities.map(amenity => (
                  <span class="rounded-xl bg-ivory px-3 py-1.5 text-[0.7rem] font-medium text-stone-700 border border-stone-200/60">
                    ✦ {amenity}
                  </span>
                ))}
              </div>
            </div>

            <!-- Price and Action Footer -->
            <div class="mt-8 border-t border-stone-200 pt-6 flex flex-wrap items-end justify-between gap-4">
              <div>
                <span class="text-[0.62rem] uppercase tracking-widest text-stone-500 font-semibold block">Tarifa por noche</span>
                <p class="display text-3xl md:text-4xl font-bold text-forest">
                  ${room.priceCLP.toLocaleString('es-CL')} <span class="font-sans text-xs font-normal text-stone-500">CLP</span>
                </p>
                <p class="text-[0.68rem] text-emerald-700 font-medium mt-0.5">✓ Desayuno e impuestos incluidos</p>
              </div>

              <div class="flex items-center gap-3">
                {room.id === 'suite-botanica' ? (
                  <a
                    href="/habitaciones/suite-botanica"
                    class="rounded-xl border border-forest/30 bg-paper px-4 py-3 text-xs font-bold tracking-wider text-forest uppercase hover:bg-stone-100 transition"
                  >
                    Ver Tour Completo
                  </a>
                ) : null}

                <button
                  type="button"
                  data-select-room={room.id}
                  data-room-name={room.name}
                  data-room-price={room.priceCLP}
                  class="btn-select-room btn-gold rounded-xl px-7 py-3 text-xs font-bold tracking-widest uppercase text-forest shadow"
                >
                  Seleccionar Suite →
                </button>
              </div>
            </div>
          </div>
        </article>
      ))}
    </div>
  </section>

  <!-- Concierge Help Banner -->
  <section class="bg-forest py-16 text-white">
    <div class="shell flex flex-col md:flex-row items-center justify-between gap-6 text-center md:text-left">
      <div>
        <span class="eyebrow text-gold-soft">Atención Personalizada 24/7</span>
        <h3 class="display mt-2 text-3xl md:text-4xl font-medium text-white">
          ¿Tienes requerimientos especiales para tu descanso?
        </h3>
        <p class="mt-2 text-xs md:text-sm text-white/70 font-light">
          Podemos preparar tu habitación con tus almohadas favoritas, temperatura exacta y flores de bienvenida.
        </p>
      </div>

      <button
        type="button"
        data-open-concierge
        class="shrink-0 btn-gold rounded-xl px-7 py-3.5 text-xs font-bold tracking-widest uppercase text-forest"
      >
        Hablar con Concierge
      </button>
    </div>
  </section>
</BaseLayout>

<script>
  import { updateBookingField } from '../../scripts/bookingStore';

  document.querySelectorAll('.btn-select-room').forEach(btn => {
    btn.addEventListener('click', () => {
      const roomId = btn.getAttribute('data-select-room') || 'suite-botanica';
      const roomName = btn.getAttribute('data-room-name') || 'Suite Botánica';
      const roomPrice = Number(btn.getAttribute('data-room-price')) || 145000;

      updateBookingField('roomId', roomId);
      updateBookingField('roomName', roomName);
      updateBookingField('roomPriceCLP', roomPrice);

      window.location.href = '/reserva/experiencias';
    });
  });

  const filterPills = document.querySelectorAll('.room-filter-pill');
  const cards = document.querySelectorAll('[data-room-card-id]');

  filterPills.forEach(pill => {
    pill.addEventListener('click', () => {
      filterPills.forEach(p => {
        p.className = 'room-filter-pill rounded-full border border-stone-200 bg-paper px-4 py-2 text-xs font-medium text-forest hover:bg-stone-100 transition';
      });
      pill.className = 'room-filter-pill rounded-full bg-forest px-4 py-2 text-xs font-bold text-white shadow-sm';

      const filter = pill.getAttribute('data-filter');
      cards.forEach(c => {
        const id = c.getAttribute('data-room-card-id');
        if (filter === 'all') {
          (c as HTMLElement).style.display = 'grid';
        } else if (filter === 'garden') {
          (c as HTMLElement).style.display = (id === 'deluxe-jardin' || id === 'villa-botanica') ? 'grid' : 'none';
        } else if (filter === 'stone-bath') {
          (c as HTMLElement).style.display = (id === 'suite-botanica' || id === 'villa-botanica') ? 'grid' : 'none';
        }
      });
    });
  });
</script>
