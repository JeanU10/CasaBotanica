---
import BaseLayout from '../../layouts/BaseLayout.astro';import Stepper from '../../components/Stepper.astro';import ReservationSummary from '../../components/ReservationSummary.astro';
---
<BaseLayout title="Pago seguro — Casa Botánica"><section class="bg-forest py-7 text-white"><div class="shell flex justify-between"><div><h1 class="display text-4xl">Tu reserva</h1><p class="text-sm text-white/70">Último paso: realiza tu pago de forma segura.</p></div><p class="hidden text-sm sm:block">◇ Pago 100% seguro</p></div></section><Stepper current={4}/><section class="shell grid gap-8 py-10 lg:grid-cols-[1fr_360px]"><form class="rounded-2xl bg-paper p-7 soft-shadow" action="/reserva/confirmacion"><h2 class="display text-4xl">Método de pago</h2><p class="mt-2 text-sm text-stone-500">Elige tu método y completa la información.</p><div class="mt-6 grid grid-cols-2 gap-3 sm:grid-cols-4">{['▰ Tarjeta','PayPal','● Pay','G Pay'].map((x,i)=><button type="button" class:list={["rounded-xl border px-3 py-4 text-sm font-bold",i===0?'border-forest':'border-stone-200']}>{x}</button>)}</div><div class="mt-7 space-y-5"><label class="block text-xs font-semibold">Nombre del titular<input value="Jean Pierre Valenzuela" class="mt-2 w-full rounded-lg border border-stone-200 px-4 py-3"/></label><label class="block text-xs font-semibold">Número de tarjeta<input value="4242 4242 4242 4242" class="mt-2 w-full rounded-lg border border-stone-200 px-4 py-3"/></label><div class="grid gap-4 sm:grid-cols-3"><label class="text-xs font-semibold">Expiración<input placeholder="MM / AA" class="mt-2 w-full rounded-lg border border-stone-200 px-4 py-3" required/></label><label class="text-xs font-semibold">CVV<input placeholder="CVV" class="mt-2 w-full rounded-lg border border-stone-200 px-4 py-3" required/></label><label class="text-xs font-semibold">País<select class="mt-2 w-full rounded-lg border border-stone-200 px-4 py-3"><option>Chile</option></select></label></div></div><div class="mt-7 rounded-xl bg-ivory p-5 text-xs"><b>◇ Compra segura</b><p class="mt-1 text-stone-500">Protegida con cifrado SSL de 256 bits.</p></div><div class="mt-7 flex justify-between gap-4"><a href="/reserva/datos" class="rounded-xl border border-forest px-6 py-4 text-sm">← Volver</a><button class="rounded-xl bg-forest px-7 py-4 text-sm font-bold text-white">Pagar $597.250 CLP</button></div></form><ReservationSummary extras/></section></BaseLayout>
