---
import BaseLayout from '../../layouts/BaseLayout.astro';
---
<BaseLayout title="Reserva confirmada — Casa Botánica"><section class="relative overflow-hidden bg-forest py-14 text-white"><div class="absolute inset-0 opacity-30 [background:url('https://images.unsplash.com/photo-1600566753086-00f18fb6b3ea?auto=format&fit=crop&w=1800&q=80')_center/cover]"></div><div class="shell relative"><p class="text-4xl text-gold">✓</p><h1 class="display mt-2 text-6xl">¡Tu reserva está confirmada!</h1><p class="mt-3 text-white/75">Gracias, Jean Pierre. Nos vemos pronto.</p><p class="mt-2 text-sm text-white/60">Enviamos los detalles a jeanpierre@mail.com</p></div></section><section class="shell grid gap-6 py-10 lg:grid-cols-[1.2fr_.8fr]"><div class="rounded-2xl bg-paper p-7 soft-shadow"><p class="eyebrow">Detalles de tu estadía</p><div class="mt-5 flex flex-col gap-5 sm:flex-row"><img src="https://images.unsplash.com/photo-1618773928121-c32242e63f39?auto=format&fit=crop&w=700&q=85" class="h-40 w-full rounded-xl object-cover sm:w-64" alt="Suite Botánica"/><div><h2 class="display text-4xl">Suite Botánica</h2><p class="mt-2 text-sm text-stone-500">2 huéspedes · 1 cama King · 32 m²</p><div class="mt-5 grid grid-cols-3 gap-6 text-xs"><div><p class="text-stone-500">Entrada</p><b>12 Ago 2026</b></div><div><p class="text-stone-500">Salida</p><b>15 Ago 2026</b></div><div><p class="text-stone-500">Noches</p><b>3 noches</b></div></div></div></div><div class="mt-7 rounded-xl bg-ivory p-6 text-center"><p class="eyebrow">Número de reserva</p><p class="display mt-2 text-5xl">BTQ-58241</p><p class="mt-1 text-xs text-stone-500">Guarda este número para cualquier consulta.</p></div></div><aside class="rounded-2xl bg-paper p-7 soft-shadow"><h2 class="display text-3xl">Resumen de tu reserva</h2><div class="mt-6 space-y-3 text-sm"><div class="flex justify-between"><span>Suite Botánica · 3 noches</span><b>$435.000</b></div><div class="flex justify-between"><span>Servicios agregados</span><b>$97.000</b></div><div class="flex justify-between"><span>Impuestos y cargos</span><b>$65.250</b></div><div class="mt-5 flex items-end justify-between border-t border-stone-200 pt-5"><b>Total pagado</b><p class="display text-4xl">$597.250</p></div></div><div class="mt-7 space-y-3">{['Agregar a calendario','Enviar confirmación por email','Descargar comprobante','Contactar con concierge'].map(x=><button class="w-full rounded-xl border border-stone-200 px-4 py-3 text-left text-sm">{x} <span class="float-right">→</span></button>)}</div><a href="/" class="mt-6 block rounded-xl bg-forest px-6 py-4 text-center text-sm font-bold text-white">Volver al inicio</a></aside></section></BaseLayout>
