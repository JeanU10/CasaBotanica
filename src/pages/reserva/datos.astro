---
import BaseLayout from '../../layouts/BaseLayout.astro';import Stepper from '../../components/Stepper.astro';import ReservationSummary from '../../components/ReservationSummary.astro';
---
<BaseLayout title="Datos del huésped — Casa Botánica"><section class="bg-forest py-7 text-white"><div class="shell"><h1 class="display text-4xl">Tu reserva</h1><p class="text-sm text-white/70">Completa tus datos personales.</p></div></section><Stepper current={3}/><section class="shell grid gap-8 py-10 lg:grid-cols-[1fr_340px]"><form class="rounded-2xl bg-paper p-7 soft-shadow" action="/reserva/pago"><h2 class="display text-4xl">Datos del huésped</h2><p class="mt-2 text-sm text-stone-500">Completa la información para tu reserva.</p><p class="eyebrow mt-8">Información personal</p><div class="mt-4 grid gap-5 md:grid-cols-2">{[['Nombre','Jean Pierre'],['Apellido','Valenzuela'],['Correo electrónico','jeanpierre@mail.com'],['Teléfono','+56 9 1234 5678'],['País de residencia','Chile'],['Documento de identidad','AB1234567']].map(x=><label class="text-xs font-semibold">{x[0]} *<input value={x[1]} class="mt-2 w-full rounded-lg border border-stone-200 bg-transparent px-4 py-3 outline-none focus:border-gold" required/></label>)}</div><p class="eyebrow mt-8 border-t border-stone-200 pt-7">Información de la estadía</p><div class="mt-4 grid gap-4 sm:grid-cols-4">{[['Llegada','12 Ago 2026'],['Salida','15 Ago 2026'],['Noches','3 noches'],['Huéspedes','2 adultos']].map(x=><div class="rounded-xl bg-ivory p-4"><p class="text-[.65rem] text-stone-500">{x[0]}</p><b class="mt-1 block text-sm">{x[1]}</b></div>)}</div><p class="eyebrow mt-8">Preferencias especiales</p><textarea class="mt-4 h-28 w-full rounded-xl border border-stone-200 p-4 text-sm outline-none focus:border-gold" placeholder="Almohadas suaves, habitación en piso alto..."></textarea><div class="mt-7 flex justify-between gap-4"><a href="/reserva/experiencias" class="rounded-xl border border-forest px-6 py-4 text-sm">← Volver</a><button class="rounded-xl bg-forest px-7 py-4 text-sm font-bold text-white">Continuar al pago →</button></div></form><ReservationSummary extras/></section></BaseLayout>
