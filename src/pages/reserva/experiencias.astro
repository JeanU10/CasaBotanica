---
import BaseLayout from '../../layouts/BaseLayout.astro';import Stepper from '../../components/Stepper.astro';import ReservationSummary from '../../components/ReservationSummary.astro';
const extras=[['Tour Viñedos Premium','4 horas · Transporte incluido','$42.000','https://images.unsplash.com/photo-1506377247377-2a5b3b417ebb?auto=format&fit=crop&w=700&q=85'],['Masaje Relajante','60 minutos','$55.000','https://images.unsplash.com/photo-1544161515-4ab6ce6db874?auto=format&fit=crop&w=700&q=85'],['Desayuno en la Habitación','Servicio a la habitación','$18.000','https://images.unsplash.com/photo-1533089860892-a7c6f0a88666?auto=format&fit=crop&w=700&q=85'],['Decoración Romántica','Flores, velas y detalles','$35.000','https://images.unsplash.com/photo-1519167758481-83f550bb49b3?auto=format&fit=crop&w=700&q=85']];
---
<BaseLayout title="Mejora tu experiencia — Casa Botánica"><section class="bg-forest py-7 text-white"><div class="shell"><h1 class="display text-4xl">Tu reserva</h1><p class="text-sm text-white/70">Personaliza tu estadía agregando experiencias y servicios.</p></div></section><Stepper current={2}/><section class="shell grid gap-8 py-10 lg:grid-cols-[1fr_340px]"><div><div class="flex flex-wrap items-end justify-between gap-4"><div><h2 class="display text-5xl">Mejora tu experiencia</h2><p class="mt-2 text-sm text-stone-500">Haz que tu estadía sea inolvidable.</p></div><a href="/reserva/datos" class="rounded-xl border border-gold px-5 py-3 text-sm text-forest">Saltar este paso</a></div><div class="mt-7 flex gap-3 overflow-x-auto pb-2">{['Todas','Tours y actividades','Gastronomía','Bienestar','Traslados'].map((x,i)=><button class:list={["shrink-0 rounded-full px-5 py-2.5 text-xs",i===0?'bg-forest text-white':'border border-stone-200 bg-paper']}>{x}</button>)}</div><div class="mt-6 grid gap-5 sm:grid-cols-2">{extras.map((e,i)=><article class="overflow-hidden rounded-2xl bg-paper soft-shadow"><img src={e[3]} alt={e[0]} class="h-48 w-full object-cover"/><div class="p-5"><span class="eyebrow">{i===0?'Más reservado':'Experiencia'}</span><h3 class="display mt-2 text-2xl">{e[0]}</h3><p class="mt-1 text-xs text-stone-500">{e[1]}</p><div class="mt-6 flex items-center justify-between"><p class="display text-2xl">{e[2]}</p><button class="extra-button grid h-10 w-10 place-items-center rounded-full border border-forest text-lg text-forest" aria-label={`Añadir ${e[0]}`}>+</button></div></div></article>)}</div><a href="/reserva/datos" class="mt-7 block rounded-xl bg-forest px-6 py-4 text-center text-sm font-bold text-white sm:ml-auto sm:w-64">Continuar →</a></div><ReservationSummary/></section><script>document.querySelectorAll('.extra-button').forEach(b=>b.addEventListener('click',()=>{b.textContent=b.textContent==='+'?'✓':'+';b.classList.toggle('bg-forest');b.classList.toggle('text-white')}));</script></BaseLayout>
