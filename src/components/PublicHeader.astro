---
const { dark = true } = Astro.props;
---
<header class:list={["fixed inset-x-0 top-0 z-50 h-20 border-b shadow-[0_10px_35px_rgba(5,28,21,.12)] backdrop-blur-xl supports-[backdrop-filter]:bg-forest/75 lg:h-24", dark ? "border-white/15 bg-forest/85 text-white" : "border-stone-200 bg-paper/85 text-ink"]}>
  <div class="shell flex h-full items-center justify-between gap-4"><a href="/" class="flex min-w-0 items-center gap-2.5 sm:gap-3"><span class="grid h-9 w-9 shrink-0 place-items-center rounded-full border border-gold text-xl text-gold sm:h-10 sm:w-10 sm:text-2xl">✤</span><span class="min-w-0 leading-none"><span class="display block whitespace-nowrap text-base tracking-wide sm:text-xl">CASA BOTÁNICA</span><span class="mt-1 block whitespace-nowrap text-[.46rem] font-semibold tracking-[.22em] text-gold sm:text-[.54rem] sm:tracking-[.28em]">HOTEL BOUTIQUE</span></span></a><nav class="hidden items-center gap-7 text-sm lg:flex"><a href="/">Inicio</a><a href="/habitaciones" class="text-gold">Habitaciones</a><a href="/#experiencias">Experiencias</a><a href="/#gastronomia">Gastronomía</a><a href="/#hotel">El hotel</a></nav><div class="flex shrink-0 items-center gap-3"><a href="/habitaciones" class="hidden rounded-xl border border-gold/40 bg-forest px-5 py-3 text-xs font-bold tracking-widest text-white sm:block">RESERVAR AHORA</a><button id="nav-toggle" class="grid h-10 w-10 place-items-center rounded-full border border-current/20 lg:hidden" aria-label="Abrir menú">☰</button></div></div>
  <nav id="nav-mobile" class:list={["hidden border-t px-6 py-5 text-center text-sm lg:hidden", dark ? "border-white/10 bg-forest" : "border-stone-200 bg-paper"]}><div class="grid gap-4"><a href="/">Inicio</a><a href="/habitaciones">Habitaciones</a><a href="/#experiencias">Experiencias</a><a href="/#hotel">El hotel</a></div></nav>
</header><script>document.querySelector('#nav-toggle')?.addEventListener('click',()=>document.querySelector('#nav-mobile')?.classList.toggle('hidden'));</script>
