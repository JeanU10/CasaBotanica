---
// Sensory Comfort Menu Modal - Refined Clean Edition
---

<div
  id="sensory-modal"
  class="fixed inset-0 z-[70] hidden items-center justify-center p-4 bg-black/60 backdrop-blur-md transition-opacity duration-300"
  role="dialog"
  aria-modal="true"
  aria-labelledby="sensory-modal-title"
>
  <div
    class="relative max-h-[90vh] w-full max-w-3xl overflow-y-auto rounded-3xl border border-gold/30 bg-[#0a231b] p-6 text-white shadow-2xl md:p-8"
  >
    <!-- Close button -->
    <button
      id="close-sensory-modal"
      class="absolute right-5 top-5 grid h-8 w-8 place-items-center rounded-full bg-white/10 text-white/70 hover:bg-white/20 hover:text-white transition text-xs"
      aria-label="Cerrar modal"
    >
      ✕
    </button>

    <div class="text-center md:text-left">
      <span class="eyebrow text-gold-soft">El Arte del Descanso Personalizado</span>
      <h2 id="sensory-modal-title" class="display mt-2 text-3xl font-medium md:text-4xl text-white">
        Menú Sensorial & Carta de Almohadas
      </h2>
      <p class="mt-2 text-xs md:text-sm text-white/75 max-w-xl">
        En Casa Botánica, tu descanso es sagrado. Selecciona tus preferencias y nuestro equipo acondicionará tu suite antes de tu llegada.
      </p>
    </div>

    <!-- Tabs: Almohadas / Aromaterapia / Ritual de Té -->
    <div class="mt-6 border-b border-white/15 flex gap-6 text-xs md:text-sm font-semibold">
      <button id="tab-pillows" class="sensory-tab border-b-2 border-gold pb-3 text-gold-light">
        Carta de Almohadas
      </button>
      <button id="tab-aroma" class="sensory-tab pb-3 text-white/60 hover:text-white">
        Aromaterapia de Suite
      </button>
      <button id="tab-tea" class="sensory-tab pb-3 text-white/60 hover:text-white">
        Ritual Nocturno
      </button>
    </div>

    <!-- Content 1: Pillows -->
    <div id="content-pillows" class="mt-6 space-y-4">
      <div class="grid gap-3 sm:grid-cols-2">
        <label class="pillow-option group flex cursor-pointer items-start gap-3.5 rounded-2xl border border-white/10 bg-white/5 p-4 transition hover:border-gold/50 hover:bg-white/10">
          <input type="radio" name="pillow-choice" value="Pluma de ganso húngaro" class="mt-1 accent-gold" checked />
          <div>
            <b class="block text-sm text-white font-medium">Pluma de Ganso Húngaro</b>
            <span class="text-[0.68rem] text-gold-light font-medium">Firmeza Suave · Extra mullida</span>
            <p class="mt-1.5 text-xs text-white/70 leading-5">Sensación de nube envolvente que alivia cualquier punto de presión en cuello y hombros.</p>
          </div>
        </label>

        <label class="pillow-option group flex cursor-pointer items-start gap-3.5 rounded-2xl border border-white/10 bg-white/5 p-4 transition hover:border-gold/50 hover:bg-white/10">
          <input type="radio" name="pillow-choice" value="Viscoelástica con infusión de lavanda" class="mt-1 accent-gold" />
          <div>
            <b class="block text-sm text-white font-medium">Viscoelástica con Lavanda</b>
            <span class="text-[0.68rem] text-gold-light font-medium">Firmeza Media · Alivio cervical</span>
            <p class="mt-1.5 text-xs text-white/70 leading-5">Espuma con memoria de forma infundida con microcápsulas de lavanda relajante.</p>
          </div>
        </label>

        <label class="pillow-option group flex cursor-pointer items-start gap-3.5 rounded-2xl border border-white/10 bg-white/5 p-4 transition hover:border-gold/50 hover:bg-white/10">
          <input type="radio" name="pillow-choice" value="Fibra de bambú orgánico" class="mt-1 accent-gold" />
          <div>
            <b class="block text-sm text-white font-medium">Bambú Orgánico Termorregulador</b>
            <span class="text-[0.68rem] text-gold-light font-medium">Firmeza Adaptativa · Frescura continua</span>
            <p class="mt-1.5 text-xs text-white/70 leading-5">Tejido hipoalergénico altamente transpirable, ideal para un sueño fresco e ininterrumpido.</p>
          </div>
        </label>

        <label class="pillow-option group flex cursor-pointer items-start gap-3.5 rounded-2xl border border-white/10 bg-white/5 p-4 transition hover:border-gold/50 hover:bg-white/10">
          <input type="radio" name="pillow-choice" value="Soporte anatómico de látex natural" class="mt-1 accent-gold" />
          <div>
            <b class="block text-sm text-white font-medium">Látex Natural Ergonómico</b>
            <span class="text-[0.68rem] text-gold-light font-medium">Firmeza Firme · Soporte vertebral</span>
            <p class="mt-1.5 text-xs text-white/70 leading-5">Perfecta alineación de la columna vertebral con rebote suave y durabilidad pura.</p>
          </div>
        </label>
      </div>
    </div>

    <!-- Content 2: Aromas -->
    <div id="content-aroma" class="mt-6 space-y-4 hidden">
      <div class="grid gap-3 sm:grid-cols-3">
        <label class="aroma-option group flex flex-col cursor-pointer justify-between rounded-2xl border border-white/10 bg-white/5 p-4 transition hover:border-gold/50 hover:bg-white/10">
          <div>
            <span class="text-gold font-bold text-xs uppercase tracking-wider block">Calma Profunda</span>
            <b class="mt-1 block text-sm text-white">Lavanda & Cedro Andino</b>
            <span class="text-[0.68rem] text-gold-light font-medium">Paz profunda & Meditación</span>
            <p class="mt-2 text-xs text-white/70 leading-5">Favorece la reducción del cortisol y un estado de serenidad total para dormir.</p>
          </div>
          <div class="mt-4 flex items-center gap-2">
            <input type="radio" name="aroma-choice" value="Lavanda & Cedro Andino" class="accent-gold" checked />
            <span class="text-xs text-white/90 font-medium">Elegir para mi suite</span>
          </div>
        </label>

        <label class="aroma-option group flex flex-col cursor-pointer justify-between rounded-2xl border border-white/10 bg-white/5 p-4 transition hover:border-gold/50 hover:bg-white/10">
          <div>
            <span class="text-gold font-bold text-xs uppercase tracking-wider block">Claridad</span>
            <b class="mt-1 block text-sm text-white">Eucalipto & Menta Silvestre</b>
            <span class="text-[0.68rem] text-gold-light font-medium">Oxigenación & Energía limpia</span>
            <p class="mt-2 text-xs text-white/70 leading-5">Abre las vías respiratorias y renueva la energía con notas herbales nítidas.</p>
          </div>
          <div class="mt-4 flex items-center gap-2">
            <input type="radio" name="aroma-choice" value="Eucalipto & Menta Silvestre" class="accent-gold" />
            <span class="text-xs text-white/90 font-medium">Elegir para mi suite</span>
          </div>
        </label>

        <label class="aroma-option group flex flex-col cursor-pointer justify-between rounded-2xl border border-white/10 bg-white/5 p-4 transition hover:border-gold/50 hover:bg-white/10">
          <div>
            <span class="text-gold font-bold text-xs uppercase tracking-wider block">Cítrico Dulce</span>
            <b class="mt-1 block text-sm text-white">Flor de Azahar & Vainilla</b>
            <span class="text-[0.68rem] text-gold-light font-medium">Calidez & Bienestar</span>
            <p class="mt-2 text-xs text-white/70 leading-5">Notas florales dulces y acogedoras que crean un ambiente hogareño de lujo.</p>
          </div>
          <div class="mt-4 flex items-center gap-2">
            <input type="radio" name="aroma-choice" value="Flor de Azahar & Vainilla" class="accent-gold" />
            <span class="text-xs text-white/90 font-medium">Elegir para mi suite</span>
          </div>
        </label>
      </div>
    </div>

    <!-- Content 3: Night Tea Ritual -->
    <div id="content-tea" class="mt-6 space-y-4 hidden">
      <div class="rounded-2xl border border-gold/20 bg-forest/40 p-5 flex flex-col md:flex-row gap-5 items-center">
        <img
          src="https://images.unsplash.com/photo-1576092768241-dec231879fc3?auto=format&fit=crop&w=600&q=80"
          alt="Infusión botánica artesanal"
          class="h-32 w-full md:w-48 rounded-xl object-cover"
        />
        <div>
          <span class="eyebrow text-gold-soft">Cortesía de Bienvenida</span>
          <h4 class="display text-xl mt-1 text-white">Infusión Silvestre de Buenas Noches</h4>
          <p class="mt-2 text-xs text-white/75 leading-5">
            Cada noche, nuestro equipo deja en tu mesa de noche una tetera de cerámica gres con una infusión recién cosechada de melisa, manzanilla dulce y pétalos de caléndula, acompañada de miel de bosque nativo.
          </p>
        </div>
      </div>
    </div>

    <!-- Action footer -->
    <div class="mt-8 flex flex-col sm:flex-row items-center justify-between gap-4 border-t border-white/10 pt-5">
      <div class="flex items-center gap-2 text-xs text-gold-soft">
        <span class="font-bold text-gold">✦</span>
        <span>Incluido en todas nuestras reservas sin costo adicional</span>
      </div>
      <button
        id="save-sensory-preferences-btn"
        class="btn-gold w-full sm:w-auto rounded-xl px-7 py-3 text-xs font-bold tracking-widest text-forest uppercase"
      >
        Guardar Preferencias
      </button>
    </div>
  </div>
</div>

<script>
  import { getStoredState, updateBookingField } from '../scripts/bookingStore';

  const modal = document.getElementById('sensory-modal');
  const closeBtn = document.getElementById('close-sensory-modal');
  const saveBtn = document.getElementById('save-sensory-preferences-btn');

  const tabPillows = document.getElementById('tab-pillows');
  const tabAroma = document.getElementById('tab-aroma');
  const tabTea = document.getElementById('tab-tea');

  const contentPillows = document.getElementById('content-pillows');
  const contentAroma = document.getElementById('content-aroma');
  const contentTea = document.getElementById('content-tea');

  const switchTab = (tab: 'pillows' | 'aroma' | 'tea') => {
    [tabPillows, tabAroma, tabTea].forEach(t => {
      t?.classList.remove('border-b-2', 'border-gold', 'text-gold-light');
      t?.classList.add('text-white/60');
    });

    contentPillows?.classList.add('hidden');
    contentAroma?.classList.add('hidden');
    contentTea?.classList.add('hidden');

    if (tab === 'pillows') {
      tabPillows?.classList.add('border-b-2', 'border-gold', 'text-gold-light');
      tabPillows?.classList.remove('text-white/60');
      contentPillows?.classList.remove('hidden');
    } else if (tab === 'aroma') {
      tabAroma?.classList.add('border-b-2', 'border-gold', 'text-gold-light');
      tabAroma?.classList.remove('text-white/60');
      contentAroma?.classList.remove('hidden');
    } else if (tab === 'tea') {
      tabTea?.classList.add('border-b-2', 'border-gold', 'text-gold-light');
      tabTea?.classList.remove('text-white/60');
      contentTea?.classList.remove('hidden');
    }
  };

  tabPillows?.addEventListener('click', () => switchTab('pillows'));
  tabAroma?.addEventListener('click', () => switchTab('aroma'));
  tabTea?.addEventListener('click', () => switchTab('tea'));

  const openSensoryModal = () => {
    modal?.classList.remove('hidden');
    modal?.classList.add('flex');
  };

  const closeSensoryModal = () => {
    modal?.classList.remove('flex');
    modal?.classList.add('hidden');
  };

  (window as unknown as { openSensoryModal: typeof openSensoryModal }).openSensoryModal = openSensoryModal;

  document.querySelectorAll('[data-open-sensory-modal]').forEach(el => {
    el.addEventListener('click', (e) => {
      e.preventDefault();
      openSensoryModal();
    });
  });

  closeBtn?.addEventListener('click', closeSensoryModal);
  modal?.addEventListener('click', (e) => {
    if (e.target === modal) closeSensoryModal();
  });

  saveBtn?.addEventListener('click', () => {
    const selectedPillow = (document.querySelector('input[name="pillow-choice"]:checked') as HTMLInputElement)?.value;
    const selectedAroma = (document.querySelector('input[name="aroma-choice"]:checked') as HTMLInputElement)?.value;

    const state = getStoredState();
    state.guestInfo.pillowPreference = selectedPillow || state.guestInfo.pillowPreference;
    state.guestInfo.aromaPreference = selectedAroma || state.guestInfo.aromaPreference;
    updateBookingField('guestInfo', state.guestInfo);

    const toast = document.getElementById('toast');
    if (toast) {
      toast.textContent = `Preferencias guardadas: Almohada (${selectedPillow}) y Aroma (${selectedAroma})`;
      toast.classList.remove('opacity-0', 'translate-y-5');
      setTimeout(() => toast.classList.add('opacity-0', 'translate-y-5'), 4000);
    }
    closeSensoryModal();
  });
</script>
