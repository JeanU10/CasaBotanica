---
import '../styles/global.css';
import PublicHeader from '../components/PublicHeader.astro';
import AtmosphereController from '../components/AtmosphereController.astro';
import SensoryMenuModal from '../components/SensoryMenuModal.astro';
import ConciergeModal from '../components/ConciergeModal.astro';
import StickyBookingBar from '../components/StickyBookingBar.astro';

interface Props {
  title: string;
  description?: string;
  showStickyBar?: boolean;
}

const {
  title,
  description = 'Casa Botánica — Hotel Boutique & Sanctuary. Una experiencia de calma, diseño y hospitalidad.',
  showStickyBar = false
} = Astro.props;
---

<!doctype html>
<html lang="es" data-atmosphere="sunset">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0d2b22" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,400&family=Manrope:wght@300;400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>
  </head>
  <body class:list={["relative min-h-screen text-ink antialiased", showStickyBar ? "pb-24" : "pb-12"]}>
    <PublicHeader />

    <main class="min-h-[calc(100vh-9rem)] pt-[4.5rem]">
      <slot />
    </main>

    <!-- Global Modals & Controls -->
    <AtmosphereController raised={showStickyBar} />
    <SensoryMenuModal />
    <ConciergeModal />
    {showStickyBar && <StickyBookingBar />}

    <!-- Global Toast Notification -->
    <div
      id="toast"
      class="pointer-events-none fixed bottom-24 left-1/2 z-[80] -translate-x-1/2 translate-y-5 rounded-full bg-[#08241b] border border-gold/40 px-6 py-3 text-xs text-white opacity-0 shadow-2xl transition-all duration-300 backdrop-blur-xl"
      role="status"
    ></div>

    <script>
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add('visible');
            }
          });
        },
        { threshold: 0.08 }
      );
      document.querySelectorAll('.fade-up').forEach((el) => observer.observe(el));
    </script>
  </body>
</html>
